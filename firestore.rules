rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the tatoebaSentences Cloud Function touches Firestore, via the
    // Admin SDK (which bypasses these rules entirely). This default-deny
    // just makes sure no client SDK can read/write it directly if one ever
    // gets pointed at this project by mistake.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
